# Copy to .env and fill in. Gitignored — never commit .env itself.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=you@company.com
JIRA_API_TOKEN=<your token>

# Optional frontend process environment (Vite deliberately does not load .env).
# Set these in the shell for local dev/build, or in Compose configuration.
# FRONTEND_PRODUCTS_URL=http://localhost:3001
# FRONTEND_ORDERS_URL=http://localhost:3002
# FRONTEND_FX_URL=http://localhost:3003/api/exchangerates/rates/a/eur/
