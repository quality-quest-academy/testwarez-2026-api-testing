meta {
  name: 02 Capture accepted offers and fresh keys
  type: http
  seq: 2
}

post {
  url: {{productsUrl}}/offers/resolve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "offerIds": ["offer-101", "offer-205"] }
}

script:pre-request {
  for (const key of ['acceptedCart', 'changedCart', 'reviewedCart', 'checkoutKey',
    'conflictKey', 'orderId', 'orderSnapshot', 'orderLocation']) {
    bru.deleteVar(key);
  }
}

script:post-response {
  const offers = res.body;
  if (res.status !== 200 || offers[0].price !== '89.00' || offers[0].version !== 3 ||
    offers[0].stock !== 8 || offers[1].price !== '35.00' || offers[1].version !== 2) {
    throw new Error('Fresh seed required: reset only your disposable project and restart at 01');
  }
  const cart = { items: offers.map(function (offer, index) {
    return { offerId: offer.id, quantity: index === 0 ? 2 : 1,
      expectedUnitPrice: offer.price, expectedOfferVersion: offer.version };
  }) };
  bru.setVar('acceptedCart', JSON.stringify(cart));
  cart.items[0].quantity = 1;
  bru.setVar('changedCart', JSON.stringify(cart));
  const run = Date.now() + '-' + Math.random().toString(16).slice(2);
  bru.setVar('checkoutKey', 'bruno-success-' + run);
  bru.setVar('conflictKey', 'bruno-conflict-' + run);
}

tests {
  test('Resolved offers preserve requested order', function () {
    expect(res.status).to.equal(200);
    expect(res.body.map(function (offer) { return offer.id; })).to.deep.equal(['offer-101', 'offer-205']);
  });
}
