meta {
  name: 08 Submit stale expectations with a fresh key
  type: http
  seq: 8
}

post {
  url: {{ordersUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{conflictKey}}
}

body:json {
  {{acceptedCart}}
}

tests {
  test('Changed offer requires explicit reconfirmation', function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal('OFFER_CHANGED');
    expect(res.body.changes[0]).to.deep.equal({ offerId: 'offer-101',
      expectedUnitPrice: '89.00', expectedOfferVersion: 3,
      currentUnitPrice: '90.00', currentOfferVersion: 4 });
  });
}
