meta {
  name: 09 Review current offers - does not submit
  type: http
  seq: 9
}

post {
  url: {{productsUrl}}/offers/resolve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "offerIds": ["offer-101", "offer-205"] }
}

script:post-response {
  if (res.status === 200) {
    const cart = { items: res.body.map(function (offer, index) {
      return { offerId: offer.id, quantity: index === 0 ? 2 : 1,
        expectedUnitPrice: offer.price, expectedOfferVersion: offer.version };
    }) };
    bru.setVar('reviewedCart', JSON.stringify(cart));
  }
}

tests {
  test('Review exposes the new price and version', function () {
    expect(res.status).to.equal(200);
    expect(res.body[0].price).to.equal('90.00');
    expect(res.body[0].version).to.equal(4);
  });
}
