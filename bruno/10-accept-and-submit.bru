meta {
  name: 10 Accept reviewed cart and submit separately
  type: http
  seq: 10
}

post {
  url: {{ordersUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{conflictKey}}
}

body:json {
  {{reviewedCart}}
}

tests {
  test('Failed key can be reused after explicit reconfirmation', function () {
    expect(res.status).to.equal(201);
    expect(res.body.subtotalEUR).to.equal('215.00');
    expect(res.body.total).to.equal('924.50');
    expect(res.body.id).not.to.equal(bru.getVar('orderId'));
  });
}

docs {
  Send only after reviewing request 09. This is an explicit acceptance/submission,
  not an automatic retry. The CLI run deliberately plays this decision in sequence.
}
