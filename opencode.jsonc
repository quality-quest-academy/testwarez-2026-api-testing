{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "jira": {
        "type": "local",
        "command": ["uvx", "mcp-atlassian@0.23.1", "--env-file", ".env"],
        "cwd": ".",
        "timeout": {
          "startup": 60000,
          "catalog": 120000
        }
      }
    }
  }
}
